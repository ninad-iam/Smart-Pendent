// ---------------- DRAWING FUNCTIONS ----------------

bool insideCircle(int x, int y, int cx, int cy, int radius) {
  int dx = x - cx;
  int dy = y - cy;

  return (dx * dx + dy * dy) <= radius * radius;
}

// Draw one of the emoji bitmaps, centred on the round screen.
void drawEmoji(const uint16_t* img) {

  const int offset = (SCREEN_WIDTH - EMOJI_SIZE) / 2;

  for (int y = 0; y < SCREEN_HEIGHT; y++) {

    uint16_t* buf = rowBuf[y & 1];

    memset(buf, 0, SCREEN_WIDTH * sizeof(uint16_t));   // black background

    int iy = y - offset;
    if (iy >= 0 && iy < EMOJI_SIZE) {
      memcpy(&buf[offset], img + (size_t)iy * EMOJI_SIZE,
             EMOJI_SIZE * sizeof(uint16_t));
    }

    LCD_addWindow(0, y, SCREEN_WIDTH, y + 1, buf);

    delayMicroseconds(500);   // give the transfer time to finish
  }
}

// Procedural face: used for "Neutral" and for the red help face.
void renderFace(String emotion, bool help) {

  for (int y = 0; y < SCREEN_HEIGHT; y++) {

    uint16_t* buf = rowBuf[y & 1];

    for (int x = 0; x < SCREEN_WIDTH; x++) {

      uint16_t pixel = BLACK;

      // Main circular face
      if (insideCircle(x, y, 180, 180, 125)) {

        pixel = help ? RED : YELLOW;

        // Eyes
        if (insideCircle(x, y, 140, 150, 9) ||
            insideCircle(x, y, 220, 150, 9)) {
          pixel = BLACK;
        }

        // Angry eyebrows
        if (emotion == "Angry" && !help) {

          if (x >= 120 && x <= 165) {
            int eyebrowY = 130 + (x - 120) / 4;
            if (abs(y - eyebrowY) <= 3) pixel = BLACK;
          }

          if (x >= 195 && x <= 240) {
            int eyebrowY = 141 - (x - 195) / 4;
            if (abs(y - eyebrowY) <= 3) pixel = BLACK;
          }
        }

        // Mouth
        if (help) {

          // Open mouth for help request
          bool outer = insideCircle(x, y, 180, 220, 20);
          bool inner = insideCircle(x, y, 180, 220, 11);
          if (outer && !inner) pixel = BLACK;

        } else if (emotion == "Happy") {

          // SMILE: middle of the mouth is LOWER on screen than the ends
          if (x >= 125 && x <= 235) {
            int dx = x - 180;
            int mouthY = 235 - (dx * dx) / 350;
            if (abs(y - mouthY) <= 4) pixel = BLACK;
          }

        } else if (emotion == "Sad") {

          // FROWN: middle of the mouth is HIGHER on screen than the ends
          if (x >= 125 && x <= 235) {
            int dx = x - 180;
            int mouthY = 215 + (dx * dx) / 350;
            if (abs(y - mouthY) <= 4) pixel = BLACK;
          }

        } else if (emotion == "Angry") {

          if (x >= 130 && x <= 230) {
            int dx = x - 180;
            int mouthY = 220 + (dx * dx) / 500;
            if (abs(y - mouthY) <= 4) pixel = BLACK;
          }

        } else {

          // Neutral straight mouth
          if (x >= 145 && x <= 215 && y >= 220 && y <= 226) {
            pixel = BLACK;
          }
        }
      }

      buf[x] = pixel;
    }

    LCD_addWindow(0, y, SCREEN_WIDTH, y + 1, buf);

    delayMicroseconds(500);
  }
}

// Pick emoji bitmap if the emotion has one, otherwise draw the simple face.
void showEmotion(const String& name) {
  int idx = findEmotion(name);

  if (idx >= 0 && EMOTIONS[idx].emojiId >= 0) {
    drawEmoji(EMOJI_TABLE[EMOTIONS[idx].emojiId]);
  } else {
    renderFace(name, false);
  }
}

// ---------------- WEBPAGE HANDLERS ----------------

void handleRoot() {
  server.send_P(200, "text/html", webpage);
}

void handleEmotion() {

  String selected = server.arg("value");

  if (findEmotion(selected) >= 0) {

    currentEmotion = selected;
    helpRequested = false;

    showEmotion(currentEmotion);

    Serial.print("Emotion selected: ");
    Serial.println(currentEmotion);

    server.send(200, "text/plain", "Emotion updated");
  } else {
    server.send(400, "text/plain", "Invalid emotion");
  }
}

void triggerHelp() {

  helpRequested = true;

  renderFace(currentEmotion, true);

  Serial.println("CAREGIVER HELP REQUESTED!");
}

void handleHelp() {

  triggerHelp();

  server.send(200, "text/plain", "Help request registered");
}

// Numeric protocol used by the Jetson Nano:
//   /code?value=1..12  -> emoji in EMOTIONS[] order (1 = Happy, 2 = Joy, ...)
//   /code?value=13     -> Neutral
//   /code?value=99     -> caregiver help request
void handleCode() {

  if (!server.hasArg("value")) {
    server.send(400, "text/plain", "Missing value");
    return;
  }

  int code = server.arg("value").toInt();

  if (code == 99) {

    triggerHelp();
    server.send(200, "text/plain", "Help request registered");

  } else if (code >= 1 && code <= EMOTION_COUNT) {

    currentEmotion = EMOTIONS[code - 1].name;
    helpRequested = false;

    showEmotion(currentEmotion);

    Serial.print("Code ");
    Serial.print(code);
    Serial.print(" -> ");
    Serial.println(currentEmotion);

    server.send(200, "text/plain", currentEmotion);

  } else {
    server.send(400, "text/plain", "Invalid code");
  }
}

// ---------------- SETUP ----------------

void setup() {

  Serial.begin(115200);
  delay(1500);

  Serial.println();
  Serial.println("Starting Emotion Teach Pendant...");

  Serial.println("Initializing I2C...");
  I2C_Init();
  delay(100);

  Serial.println("Initializing TCA9554...");
  TCA9554PWR_Init(0x00);
  delay(100);

  Serial.println("Initializing backlight...");
  Backlight_Init();
  delay(100);

  Serial.println("Initializing ST77916 display...");
  ST77916_Init();
  delay(500);

  // Draw initial neutral face
  showEmotion(currentEmotion);

  // Start Wi-Fi hotspot
  Serial.println("Starting Wi-Fi hotspot...");

  WiFi.mode(WIFI_AP);
  WiFi.softAP(ssid, password);

  Serial.print("Hotspot IP address: ");
  Serial.println(WiFi.softAPIP());

  server.on("/", handleRoot);
  server.on("/emotion", handleEmotion);
  server.on("/help", handleHelp);
  server.on("/code", handleCode);

  server.begin();

  Serial.println("Web server started!");
  Serial.println("Emotion Pendant is ready.");
}

// ---------------- MAIN LOOP ----------------

void loop() {
  server.handleClient();
}