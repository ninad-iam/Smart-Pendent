const char* password = "12345678";

WebServer server(80);

// ---------------- PENDANT STATE ----------------

String currentEmotion = "Neutral";
bool helpRequested = false;

// ---------------- DISPLAY SETTINGS ----------------

#define SCREEN_WIDTH 360
#define SCREEN_HEIGHT 360

// RGB565 colours
#define BLACK  0x0000
#define WHITE  0xFFFF
#define YELLOW 0xFFE0
#define RED    0xF800

// Two row buffers, alternated, so the display never reads a row
// while we are overwriting it.
uint16_t rowBuf[2][SCREEN_WIDTH];

// ---------------- EMOTION TABLE ----------------

struct EmotionEntry {
  const char* name;
  int emojiId;               // -1 = draw procedurally
};

const EmotionEntry EMOTIONS[] = {
  {"Happy",     EMOJI_HAPPY},
  {"Joy",       EMOJI_JOY},
  {"Wink",      EMOJI_WINK},
  {"Sad",       EMOJI_SAD},
  {"Surprised", EMOJI_SURPRISED},
  {"Dizzy",     EMOJI_DIZZY},
  {"Worried",   EMOJI_WORRIED},
  {"Love",      EMOJI_LOVE},
  {"Angry",     EMOJI_ANGRY},
  {"Silly",     EMOJI_SILLY},
  {"Excited",   EMOJI_EXCITED},
  {"Sick",      EMOJI_SICK},
  {"Neutral",   -1},
};
const int EMOTION_COUNT = sizeof(EMOTIONS) / sizeof(EMOTIONS[0]);

int findEmotion(const String& name) {
  for (int i = 0; i < EMOTION_COUNT; i++) {
    if (name == EMOTIONS[i].name) return i;
  }
  return -1;
}

